{
  "manifest_version": 3,
  "name": "Poker Advisor",
  "version": "1.0.0",
  "description": "Real-time low-stakes poker strategy advice, player notes and stats for PokerNow, KG Poker and other browser poker sites.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "*://*.pokernow.com/*",
    "*://*.pokernow.club/*",
    "*://kgpoker.fly.dev/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "Poker Advisor" },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.pokernow.com/*", "*://*.pokernow.club/*", "*://kgpoker.fly.dev/*"],
      "js": [
        "src/core/cards.js",
        "src/core/evaluator.js",
        "src/core/ranges.js",
        "src/core/equity.js",
        "src/core/sizing.js",
        "src/core/profiles.js",
        "src/core/strategy.js",
        "src/storage.js",
        "src/tracker.js",
        "src/adapters/dom.js",
        "src/adapters/sites.js",
        "src/ui/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
